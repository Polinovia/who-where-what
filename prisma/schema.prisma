// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LobbyStatus {
  LOBBY
  IN_PROGRESS
  FINISHED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  players     Player[]
  friendships Friendship[] @relation("FriendshipUser")
  friendOf    Friendship[] @relation("FriendshipFriend")
}

model Friendship {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation("FriendshipUser", fields: [userId], references: [id])

  friendId String
  friend   User   @relation("FriendshipFriend", fields: [friendId], references: [id])

  @@unique([userId, friendId])
}

model Lobby {
  id             String      @id @default(cuid())
  code           String      @unique
  name           String?
  status         LobbyStatus @default(LOBBY)
  maxPlayers     Int         @default(12)
  totalQuestions Int         @default(8)
  currentRound   Int         @default(0)
  createdAt      DateTime    @default(now())

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  players Player[]
  stories Story[]
}

model Player {
  id       String   @id @default(cuid())
  pseudo   String
  isHost   Boolean  @default(false)
  seat     Int?
  ready    Boolean  @default(false)
  kicked   Boolean  @default(false)
  joinedAt DateTime @default(now())

  lobbyId String
  lobby   Lobby  @relation(fields: [lobbyId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  answers        Answer[]
  storiesStarted Story[]  @relation("StoryStarter")

  @@unique([lobbyId, pseudo])
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  questions Question[]
  lobbies   Lobby[]
}

model Question {
  id         String   @id @default(cuid())
  text       String
  order      Int

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  answers Answer[]

  @@unique([categoryId, order])
}

// One story sheet per player, passed around the table question by question.
model Story {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  lobbyId String
  lobby   Lobby  @relation(fields: [lobbyId], references: [id])

  starterPlayerId String
  starterPlayer   Player @relation("StoryStarter", fields: [starterPlayerId], references: [id])

  answers Answer[]
}

model Answer {
  id    String @id @default(cuid())
  text  String
  order Int

  storyId String
  story   Story  @relation(fields: [storyId], references: [id])

  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  @@unique([storyId, order])
}
